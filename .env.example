# Site IWOK — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.

# URL du projet Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# JWT signé avec le rôle Postgres `iwok_app`.
# Généré via : SUPABASE_JWT_SECRET="..." node scripts/generate-iwok-jwt.mjs
# Voir docs/supabase-isolation-migration.md
IWOK_DB_KEY=

# Secret partagé pour invalider le cache ISR depuis le dashboard CMS
# Générer une chaîne aléatoire 32+ octets : openssl rand -hex 32
REVALIDATE_SECRET=

# Clé anon publique du projet Supabase (Project Settings → API → Project API keys)
# Sert à passer le gateway Kong ; les permissions DB sont définies par IWOK_DB_KEY.
SUPABASE_ANON_KEY=

# Brevo (ex-Sendinblue) — envoi des demandes de devis par email à Guillaume
# Clé API : Brevo Dashboard → SMTP & API → API Keys (free tier : 300/jour)
BREVO_API_KEY=
# Email destinataire des demandes de devis
CONTACT_TO_EMAIL=contact@guihome-art.com
# Email expéditeur — doit être un sender vérifié dans Brevo (ou un domaine
# vérifié via DNS DKIM/SPF). Recommandé : noreply@guihome-art.com
CONTACT_FROM_EMAIL=noreply@guihome-art.com
