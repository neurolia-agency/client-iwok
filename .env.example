# Site IWOK — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.

# URL du projet Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# JWT signé avec le rôle Postgres `iwok_app`.
# Généré via : SUPABASE_JWT_SECRET="..." node scripts/generate-iwok-jwt.mjs
# Voir docs/supabase-isolation-migration.md
IWOK_DB_KEY=

# Secret partagé pour invalider le cache ISR depuis le dashboard CMS
# Générer une chaîne aléatoire 32+ octets : openssl rand -hex 32
REVALIDATE_SECRET=
